{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/notifications/trigger",
      "schedule": "0 16 * * 1-5"
    },
    {
      "path": "/api/cron/prices",
      "schedule": "30 22 * * 1-5"
    }
  ]
}
